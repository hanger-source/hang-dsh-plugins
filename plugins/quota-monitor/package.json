{
  "name": "@hanger-source/dsh-quota-monitor",
  "version": "0.2.1",
  "description": "DSH OpenCode Go 订阅用量与 DeepSeek 官方余额",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanger-source/hang-dsh-plugins.git",
    "directory": "plugins/quota-monitor"
  },
  "homepage": "https://github.com/hanger-source/hang-dsh-plugins/tree/main/plugins/quota-monitor#readme",
  "bugs": {
    "url": "https://github.com/hanger-source/hang-dsh-plugins/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
